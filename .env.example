# Retell. The server uses the key ONLY to verify X-Retell-Signature on every request
# (use the key with the webhook badge in Retell's API Keys tab). scripts/create_agent.py
# uses the same key to create the LLM and agent.
RETELL_API_KEY=your-retell-api-key
# ALLOW_UNSIGNED=1   # local development only: accept requests with no signature

# Bearer token for GET /calls and GET /calendar.ics
ADMIN_TOKEN=make-a-long-random-string

BUSINESS_NAME=Harbour Dental Clinic
BUSINESS_TZ=Europe/London
SLOT_MINUTES=30
MIN_NOTICE_MINUTES=60
DATA_DIR=var

# Calendar: local (SQLite + .ics) or google
CALENDAR_BACKEND=local
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=               # path to the key file, or...
GOOGLE_SERVICE_ACCOUNT_JSON=               # ...the key JSON itself, e.g. loaded from a secret store

# Summary and handover emails go to this ONE address only. Leave SMTP_HOST empty and
# messages go to var/outbox.jsonl instead.
TEAM_EMAIL=frontdesk@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
